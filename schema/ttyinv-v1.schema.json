{
  "$defs": {
    "party": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "email": {
          "format": "email",
          "type": "string"
        },
        "identifiers": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "logo": {
          "type": "string"
        },
        "logo_alt": {
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "website": {
          "format": "uri",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "paymentMethod": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "fields"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/kaygdotorg/ttyinv/blob/main/schema/ttyinv-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "appearance": {
      "additionalProperties": false,
      "properties": {
        "accent": {
          "type": "string"
        },
        "density": {
          "enum": [
            "comfortable",
            "compact"
          ]
        },
        "font": {
          "type": "string"
        },
        "ink": {
          "type": "string"
        },
        "muted": {
          "type": "string"
        },
        "paper": {
          "type": "string"
        },
        "theme": {
          "enum": [
            "light",
            "dark"
          ]
        }
      },
      "type": "object"
    },
    "from": {
      "$ref": "#/$defs/party"
    },
    "invoice": {
      "additionalProperties": true,
      "properties": {
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        "due": {
          "format": "date",
          "type": "string"
        },
        "issued": {
          "format": "date",
          "type": "string"
        },
        "locale": {
          "default": "en-GB",
          "type": "string"
        },
        "number": {
          "minLength": 1,
          "type": "string"
        },
        "reference": {
          "type": "string"
        },
        "terms": {
          "type": "string"
        },
        "title": {
          "default": "Invoice",
          "type": "string"
        }
      },
      "required": [
        "number",
        "issued",
        "currency"
      ],
      "type": "object"
    },
    "payment": {
      "additionalProperties": false,
      "properties": {
        "methods": {
          "items": {
            "$ref": "#/$defs/paymentMethod"
          },
          "type": "array"
        },
        "title": {
          "default": "Payment",
          "type": "string"
        }
      },
      "type": "object"
    },
    "schema": {
      "const": "ttyinv/v1"
    },
    "settlements": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "type": "array"
    },
    "signature": {
      "additionalProperties": false,
      "properties": {
        "alt": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "label": {
          "default": "Authorized signature",
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "image"
      ],
      "type": "object"
    },
    "to": {
      "$ref": "#/$defs/party"
    }
  },
  "required": [
    "schema",
    "invoice",
    "from",
    "to"
  ],
  "title": "ttyinv/v1 invoice frontmatter",
  "type": "object",
  "x-ttyinv-markdown": {
    "calculation": "Blank or auto Amount values are calculated from Quantity/Qty/Days/Hours × Rate/Unit price.",
    "financialTable": "A GFM table with an Amount or Amount (CUR) column is financial.",
    "rawHtml": "Raw HTML is excluded except the literal <br> separator inside table cells.",
    "sectionHeading": "Level-two headings (##) define sections."
  }
}
